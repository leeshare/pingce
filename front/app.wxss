/* app.wxss - 全局样式 */

/* 色彩变量（对齐设计图 snx 设计令牌） */
page {
  /* 主色：海军蓝（教育、信任） */
  --snx-primary-50: #eef4ff;
  --snx-primary-100: #d9e6ff;
  --snx-primary-500: #3366ff;
  --snx-primary-600: #1e4bec;
  --snx-primary-700: #1539c0;

  /* 中性色 */
  --snx-neutral-0: #ffffff;
  --snx-neutral-50: #f8f9fb;
  --snx-neutral-100: #f1f3f6;
  --snx-neutral-200: #e3e7ed;
  --snx-neutral-300: #c9ced7;
  --snx-neutral-400: #9ca3b0;
  --snx-neutral-500: #6b7280;
  --snx-neutral-700: #374151;
  --snx-neutral-800: #1f2937;
  --snx-neutral-900: #111827;

  /* 暖色（VIP/奖励） */
  --snx-warm-100: #ffedd5;
  --snx-warm-600: #ea580c;

  /* 状态色 */
  --snx-state-success: #10b981;

  /* 语义别名 */
  --color-primary: #1e4bec;
  --color-primary-light: #3366ff;
  --color-primary-dark: #1539c0;
  --color-success: #10b981;
  --color-danger: #ef4444;
  --color-warning: #f59e0b;
  --color-info: #3b82f6;
  --color-text: #111827;
  --color-text-secondary: #6b7280;
  --color-bg: #f8f9fb;
  --color-card: #ffffff;
  --color-border: #e3e7ed;
  --color-white: #ffffff;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;

  /* 阴影 */
  --shadow-1: 0 2rpx 4rpx rgba(15, 23, 42, 0.05), 0 2rpx 2rpx rgba(15, 23, 42, 0.03);
  --shadow-2: 0 8rpx 24rpx -8rpx rgba(15, 23, 42, 0.12);

  background-color: var(--color-bg);
  color: var(--color-text);
  font-family: 'Inter', 'Noto Sans SC', 'PingFang SC', -apple-system, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: var(--color-white);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 标题 */
.title-lg {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--color-text);
}

.title-md {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-text);
}

.text-secondary {
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

/* 按钮 */
.btn-primary {
  background: var(--color-primary);
  color: var(--color-white);
  border-radius: 48rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary:active {
  background: var(--color-primary-dark);
}

.btn-outline {
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  border-radius: 48rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
  background: transparent;
}

/* flex 布局 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}

.tag-primary {
  background: rgba(43, 108, 176, 0.1);
  color: var(--color-primary);
}

.tag-success {
  background: rgba(56, 161, 105, 0.1);
  color: var(--color-success);
}

.tag-danger {
  background: rgba(229, 62, 62, 0.1);
  color: var(--color-danger);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 24rpx 0;
}

/* 空隙 */
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
