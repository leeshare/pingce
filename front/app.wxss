/* app.wxss - 全局样式 */

/* 色彩变量 */
page {
  --color-primary: #2B6CB0;
  --color-primary-light: #3182CE;
  --color-primary-dark: #2C5282;
  --color-success: #38A169;
  --color-danger: #E53E3E;
  --color-warning: #DD6B20;
  --color-info: #805AD5;
  --color-text: #1A202C;
  --color-text-secondary: #718096;
  --color-bg: #F7FAFC;
  --color-border: #E2E8F0;
  --color-white: #FFFFFF;

  background-color: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: var(--color-white);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 标题 */
.title-lg {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--color-text);
}

.title-md {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-text);
}

.text-secondary {
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

/* 按钮 */
.btn-primary {
  background: var(--color-primary);
  color: var(--color-white);
  border-radius: 48rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary:active {
  background: var(--color-primary-dark);
}

.btn-outline {
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  border-radius: 48rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
  background: transparent;
}

/* flex 布局 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}

.tag-primary {
  background: rgba(43, 108, 176, 0.1);
  color: var(--color-primary);
}

.tag-success {
  background: rgba(56, 161, 105, 0.1);
  color: var(--color-success);
}

.tag-danger {
  background: rgba(229, 62, 62, 0.1);
  color: var(--color-danger);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 24rpx 0;
}

/* 空隙 */
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
