// pages/mockexam/mockexam.wxs
// 选项状态判断，供 wxml 条件 class 使用

// 普通题：是否选中
var isSelected = function (selected, idx) {
  if (!selected) return false
  for (var i = 0; i < selected.length; i++) {
    if (selected[i] === idx) return true
  }
  return false
}

// 普通题：是否为正确选项
var isOptionCorrect = function (question, idx) {
  if (!question) return false
  var correct = question.correct
  var opt = question.options[idx]
  if (!opt) return false
  var key = opt.letter || opt.text
  if (Object.prototype.toString.call(correct) === '[object Array]') {
    for (var i = 0; i < correct.length; i++) {
      if (key === correct[i]) return true
    }
  } else {
    return key === correct
  }
  return false
}

// 子题：是否选中
var isSubSelected = function (subAnswers, sIdx, oIdx) {
  if (!subAnswers) return false
  var ans = subAnswers[sIdx]
  if (!ans || !ans.selected) return false
  for (var i = 0; i < ans.selected.length; i++) {
    if (ans.selected[i] === oIdx) return true
  }
  return false
}

// 子题：是否为正确选项
var isSubOptionCorrect = function (sub, idx) {
  if (!sub) return false
  var correct = sub.correct
  var opt = sub.options[idx]
  if (!opt) return false
  var key = opt.letter || opt.text
  if (Object.prototype.toString.call(correct) === '[object Array]') {
    for (var i = 0; i < correct.length; i++) {
      if (key === correct[i]) return true
    }
  } else {
    return key === correct
  }
  return false
}

module.exports = {
  isSelected: isSelected,
  isOptionCorrect: isOptionCorrect,
  isSubSelected: isSubSelected,
  isSubOptionCorrect: isSubOptionCorrect,
}
