/* pages/exam_history/exam_history.wxss */

.page-history {
  --snx-red: #a51d26;
  --snx-red-50: #fef2f2;
  --snx-red-200: #f9d0d0;
  --snx-red-700: #a52a2a;
  --snx-bg: #f7f6f3;
  --snx-card: #ffffff;
  --snx-border: #e7e5e4;
  --snx-text: #1f2937;
  --snx-text-secondary: #6b7280;
  --snx-text-muted: #9ca3af;
  --snx-muted: #f5f5f7;
  --snx-green: #15803d;
  --snx-green-50: #f0fdf4;
  --snx-green-200: #bbf7d0;

  height: 100vh;
  background: var(--snx-bg);
  color: var(--snx-text);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ===== 状态层 ===== */
.state-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 32rpx;
  gap: 16rpx;
}

.loading-text,
.error-text,
.empty-text {
  font-size: 28rpx;
  color: var(--snx-text-muted);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--snx-text-muted);
}

.retry-btn {
  padding: 16rpx 48rpx;
  background: var(--snx-red);
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  margin-top: 16rpx;
}

.retry-btn:active {
  opacity: 0.85;
}

/* ===== 列表 ===== */
.history-list {
  flex: 1;
  min-height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.record-card {
  background: var(--snx-card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid var(--snx-border);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  transition: box-shadow 0.2s ease;
}

.record-card:active {
  box-shadow: 0 8rpx 24rpx -8rpx rgba(15, 23, 42, 0.12);
}

.record-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.record-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--snx-text);
  line-height: 1.4;
  flex: 1;
}

.record-score {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.record-score.pass {
  background: var(--snx-green-50);
  border: 2rpx solid var(--snx-green-200);
}

.record-score.fail {
  background: var(--snx-red-50);
  border: 2rpx solid var(--snx-red-200);
}

.score-value {
  font-size: 36rpx;
  font-weight: 700;
}

.record-score.pass .score-value {
  color: var(--snx-green);
}

.record-score.fail .score-value {
  color: var(--snx-red-700);
}

.score-total {
  font-size: 24rpx;
  color: var(--snx-text-muted);
}

.record-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-top: 2rpx solid var(--snx-border);
  border-bottom: 2rpx solid var(--snx-border);
  margin-bottom: 16rpx;
}

.meta-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.meta-label {
  font-size: 22rpx;
  color: var(--snx-text-muted);
}

.meta-value {
  font-size: 26rpx;
  color: var(--snx-text-secondary);
}

.meta-divider {
  width: 2rpx;
  height: 40rpx;
  background: var(--snx-border);
}

.record-arrow {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.arrow-text {
  font-size: 24rpx;
  color: var(--snx-red-700);
}

.arrow-icon {
  font-size: 32rpx;
  color: var(--snx-red-700);
  line-height: 1;
}

.bottom-space {
  height: 32rpx;
}
