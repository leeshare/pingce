<view class="page-mine">
  <!-- 用户信息区 -->
  <view class="user-header">
    <block wx:if="{{isLogged}}">
      <image class="user-avatar" src="{{userInfo.avatar || '/assets/icons/default-avatar.png'}}" mode="aspectFill" />
      <view class="user-meta">
        <text class="user-name">{{userInfo.nickname}}</text>
        <text class="user-id">ID: {{userInfo.userId}}</text>
      </view>
      <view class="logout-btn" bindtap="handleLogout">退出</view>
    </block>
    <block wx:else>
      <image class="user-avatar" src="/assets/icons/default-avatar.png" mode="aspectFill" />
      <view class="user-meta" bindtap="handleLogin">
        <text class="user-name">点击登录</text>
        <text class="user-id">登录后享受更多服务</text>
      </view>
    </block>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-list">
    <view class="card menu-item" wx:for="{{menus}}" wx:key="id" data-name="{{item.name}}" data-url="{{item.url}}" bindtap="handleMenu">
      <text class="menu-icon">{{item.icon}}</text>
      <text class="menu-name">{{item.name}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
