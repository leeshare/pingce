/* pages/college/college.wxss */

.page-college {
  padding: 24rpx 32rpx 120rpx;
  background: var(--color-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 搜索区 */
.search-section {
  background: var(--color-bg);
  padding-bottom: 16rpx;
}

.search-box {
  position: relative;
  display: flex;
  align-items: center;
  height: 88rpx;
  background: var(--snx-neutral-100);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  border: 2rpx solid transparent;
}

.search-box:focus-within {
  border-color: var(--color-primary-light);
  background: var(--color-card);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  color: var(--color-text-secondary);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  height: 100%;
}

.search-clear {
  font-size: 28rpx;
  color: var(--snx-neutral-400);
  padding: 8rpx;
}

/* 筛选 chip */
.chip-row {
  margin-top: 24rpx;
  white-space: nowrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  color: var(--snx-neutral-700);
  font-size: 26rpx;
  margin-right: 16rpx;
}

.chip-active {
  background: var(--snx-primary-50);
  border-color: var(--snx-primary-100);
  color: var(--color-primary);
}

.chip-arrow {
  font-size: 20rpx;
  color: var(--snx-neutral-400);
}

/* 快速 tab */
.tab-bar {
  margin-top: 16rpx;
  margin-bottom: 16rpx;
}

.tab-scroll {
  white-space: nowrap;
}

.tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: var(--snx-neutral-100);
  color: var(--snx-neutral-600);
  font-size: 26rpx;
  font-weight: 500;
  margin-right: 16rpx;
}

.tab-active {
  background: var(--color-primary);
  color: var(--color-white);
}

/* 院校列表 */
.list {
  margin-top: 16rpx;
}

.college-card {
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-1);
}

.college-top {
  display: flex;
  gap: 24rpx;
}

.college-logo {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  background: var(--snx-primary-100);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
}

.college-main {
  flex: 1;
  min-width: 0;
}

.college-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.college-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.3;
  flex: 1;
}

.college-score-tag {
  padding: 4rpx 16rpx;
  background: var(--snx-primary-50);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  white-space: nowrap;
}

.college-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.college-tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: var(--radius-sm);
  background: var(--snx-primary-50);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 500;
}

.college-meta {
  display: flex;
  gap: 32rpx;
  margin-top: 20rpx;
}

.meta-item {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.college-footer {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 56rpx;
}

.footer-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-primary);
}

.footer-arrow {
  font-size: 32rpx;
  color: var(--snx-neutral-400);
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 96rpx;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* 加载中 / 没有更多 */
.loading,
.no-more {
  padding: 32rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--snx-neutral-400);
}

/* 智能匹配 CTA */
.match-cta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--color-primary);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-2);
}

.match-icon {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.match-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.match-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.match-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.match-arrow {
  font-size: 40rpx;
  color: #fff;
  flex-shrink: 0;
}
