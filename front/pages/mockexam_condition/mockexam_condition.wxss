/* pages/mockexam_condition/mockexam_condition.wxss */

.page-mockexam {
  --snx-red: #a51d26;
  --snx-red-light: #c62828;
  --snx-red-dark: #712526;
  --snx-red-50: #fef2f2;
  --snx-red-100: #fce7e7;
  --snx-red-200: #f9d0d0;
  --snx-red-700: #a52a2a;
  --snx-red-900: #712526;
  --snx-bg: #f7f6f3;
  --snx-card: #ffffff;
  --snx-border: #e7e5e4;
  --snx-text: #1f2937;
  --snx-text-secondary: #6b7280;
  --snx-text-muted: #9ca3af;
  --snx-muted: #f5f5f7;

  height: 100vh;
  background: var(--snx-bg);
  color: var(--snx-text);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ===== 副标题条 ===== */
.me-subtitle-bar {
  background: var(--snx-red);
  padding: 0 40rpx 24rpx;
}

.me-subtitle {
  font-size: 24rpx;
  color: #fecaca;
}

/* ===== 主体 ===== */
.me-body {
  flex: 1;
  min-height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

/* ===== 倒计时卡片 ===== */
.countdown-card {
  background: linear-gradient(135deg, var(--snx-red-700), var(--snx-red-900));
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(165, 29, 38, 0.3);
}

.countdown-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.countdown-icon {
  font-size: 36rpx;
  line-height: 1;
}

.countdown-label {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
}

.countdown-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.4;
}

/* ===== 模考说明卡片 ===== */
.info-card {
  background: var(--snx-card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid var(--snx-border);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.info-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--snx-text);
  margin-bottom: 24rpx;
  display: block;
}

.info-grid {
  display: flex;
  gap: 16rpx;
}

.info-item {
  flex: 1;
  background: var(--snx-muted);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.info-item-label {
  font-size: 22rpx;
  color: var(--snx-text-secondary);
}

.info-item-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--snx-text);
}

/* ===== 模考试卷列表 ===== */
.papers-section {
  margin-bottom: 24rpx;
}

.papers-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--snx-text);
  margin-bottom: 16rpx;
  padding: 0 8rpx;
  display: block;
}

.paper-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.paper-card {
  background: var(--snx-card);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 2rpx solid var(--snx-border);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.paper-card-header {
  margin-bottom: 24rpx;
}

.paper-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--snx-text);
  line-height: 1.4;
  margin-bottom: 16rpx;
  display: block;
}

.paper-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}

.paper-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: var(--snx-red-50);
  color: var(--snx-red-700);
  border: 2rpx solid var(--snx-red-200);
}

.paper-tag-hard {
  background: #fef2f2;
  color: #b91c1c;
  border-color: #fecaca;
}

.paper-tag-medium {
  background: var(--snx-red-50);
  color: var(--snx-red-700);
  border-color: var(--snx-red-200);
}

.paper-tag-easy {
  background: #f0fdf4;
  color: #15803d;
  border-color: #bbf7d0;
}

.paper-info {
  font-size: 24rpx;
  color: var(--snx-text-secondary);
}

.paper-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.paper-reference {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.paper-reference-icon {
  font-size: 28rpx;
  line-height: 1;
}

.paper-reference-text {
  font-size: 24rpx;
  color: var(--snx-text-secondary);
}

.paper-start-btn {
  background: var(--snx-red);
  color: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.paper-start-btn:active {
  background: var(--snx-red-light);
  transform: scale(0.98);
}

/* ===== 加载/错误/空状态 ===== */
.loading-wrap,
.error-wrap,
.empty-wrap {
  background: var(--snx-card);
  border-radius: 24rpx;
  padding: 64rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--snx-border);
}

.loading-text,
.error-text,
.empty-text {
  font-size: 28rpx;
  color: var(--snx-text-muted);
}

/* ===== 查看历史成绩 ===== */
.history-entry {
  background: var(--snx-card);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid var(--snx-border);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  transition: box-shadow 0.2s ease;
}

.history-entry:active {
  box-shadow: 0 8rpx 24rpx -8rpx rgba(15, 23, 42, 0.12);
}

.history-entry-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.history-entry-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--snx-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
  flex-shrink: 0;
}

.history-entry-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.history-entry-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--snx-text);
}

.history-entry-desc {
  font-size: 24rpx;
  color: var(--snx-text-secondary);
}

.history-entry-arrow {
  font-size: 40rpx;
  color: var(--snx-text-muted);
  line-height: 1;
}

.me-bottom-space {
  height: 32rpx;
}
