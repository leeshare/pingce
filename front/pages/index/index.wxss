/* pages/index/index.wxss */

.page-home {
  padding: 32rpx 32rpx 80rpx;
  background: var(--color-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部问候 */
.greeting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.greeting-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.greeting-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.3;
}

.vip-badge {
  padding: 4rpx 16rpx;
  background: var(--snx-warm-100);
  border-radius: 999rpx;
}

.vip-badge-text {
  font-size: 22rpx;
  color: var(--snx-warm-600);
  font-weight: 500;
}

.greeting-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* 统计行 */
.stats-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.stat-card {
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: var(--shadow-1);
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.stat-value {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.stat-unit {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.stat-num-success {
  color: var(--snx-state-success);
}

.stat-unit-success {
  color: var(--snx-state-success);
}

/* 主 CTA 卡片 */
.cta-card {
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-1);
}

.btn-primary-lg {
  width: 100%;
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  color: var(--color-white);
  border-radius: var(--radius-md);
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1.5;
}

.btn-primary-lg::after {
  border: none;
}

.btn-primary-hover {
  background: var(--color-primary-dark);
  transform: translateY(-2rpx);
}

.btn-primary-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.cta-secondary {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.btn-outline-md {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--snx-neutral-50);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.btn-outline-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--snx-neutral-700);
}

/* 分类入口 */
.category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.category-item {
  min-height: 160rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-1);
}

.category-item:active {
  background: var(--snx-neutral-50);
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  background: var(--snx-primary-50);
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-icon-emoji {
  font-size: 40rpx;
}

.category-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.category-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.category-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 通用卡片头 */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.card-more {
  font-size: 24rpx;
  color: var(--color-primary);
}

/* 继续学习 */
.continue-card {
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-1);
}

.continue-body {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.continue-icon {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  background: var(--snx-primary-50);
  display: flex;
  align-items: center;
  justify-content: center;
}

.continue-icon-emoji {
  font-size: 40rpx;
}

.continue-content {
  flex: 1;
  min-width: 0;
}

.continue-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.continue-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 16rpx;
}

.continue-percent {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.progress-bar {
  margin-top: 16rpx;
  height: 6rpx;
  width: 100%;
  background: var(--snx-neutral-100);
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: var(--color-primary);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

/* 升学工具 */
.tools-section {
  margin-bottom: 32rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.tools-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.tool-item {
  min-height: 144rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-1);
}

.tool-item:active {
  background: var(--snx-neutral-50);
}

.tool-icon {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  background: var(--snx-primary-50);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-icon-emoji {
  font-size: 40rpx;
}

.tool-info {
  display: flex;
  flex-direction: column;
}

.tool-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.tool-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 备考资讯 */
.news-card {
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-1);
}

.news-list {
  display: flex;
  flex-direction: column;
}

.news-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--color-border);
  gap: 16rpx;
}

.news-item:last-child {
  border-bottom: none;
}

.news-tag {
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.news-tag-policy {
  background: var(--snx-primary-50);
  color: var(--color-primary);
}

.news-tag-info {
  background: #dbeafe;
  color: var(--color-info);
}

.news-tag-hot {
  background: var(--snx-warm-100);
  color: var(--snx-warm-600);
}

.news-title {
  flex: 1;
  font-size: 28rpx;
  color: var(--snx-neutral-700);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.news-arrow {
  font-size: 24rpx;
  color: var(--snx-neutral-400);
  flex-shrink: 0;
}
