/* pages/index/index.wxss */

/* 设计令牌：对齐 home.html 设计稿（陕西单招红 + 暖灰底） */
.page-home {
  --snx-red: #a51d26;
  --snx-red-dark: #8a1820;
  --snx-red-light: #c62828;
  --snx-bg: #f7f6f3;
  --snx-card: #ffffff;
  --snx-border: #e7e5e4;
  --snx-text: #1f2937;
  --snx-text-secondary: #78716c;
  --snx-text-muted: #57534e;

  --snx-amber-50: #fffbeb;
  --snx-amber-100: #fef3c7;
  --snx-amber-200: #fde68a;
  --snx-amber-500: #f59e0b;
  --snx-amber-700: #b45309;
  --snx-amber-800: #92400e;
  --snx-red-50: #fef2f2;

  min-height: 100vh;
  padding: 0 0 48rpx;
  background: var(--snx-bg);
  box-sizing: border-box;
  color: var(--snx-text);
}

/* ===== 红色头部 ===== */
.home-header {
  background: var(--snx-red);
  padding: 16rpx 40rpx 36rpx;
  color: #fff;
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-sub {
  font-size: 32rpx;
  color: #fecaca;
  letter-spacing: 4rpx;
}

.header-bell {
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid rgba(252, 165, 165, 0.7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-bell:active {
  background: rgba(255, 255, 255, 0.12);
}

.header-bell-icon {
  font-size: 32rpx;
  line-height: 1;
  width: 60%;
  width: 20px;
  height: 20px;
}

.header-search {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-search:active {
  background: rgba(255, 255, 255, 0.18);
}

.search-text {
  font-size: 26rpx;
  color: #fee2e2;
}

/* ===== 公告轮播 ===== */
.ad-wrap {
  padding: 32rpx 32rpx 0;
}

.ad-swiper {
  width: 100%;
  height: 220rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
}

.ad-card {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ad-card-amber {
  background: linear-gradient(to right, var(--snx-amber-50), #fff7ed);
  border: 2rpx solid var(--snx-amber-200);
}

.ad-card-red {
  background: linear-gradient(135deg, var(--snx-red), var(--snx-red-light));
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  gap: 20rpx;
}

.ad-icon-circle {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ad-icon-amber {
  background: var(--snx-amber-500);
  color: #fff;
}

.ad-icon-red {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.ad-icon {
  font-size: 32rpx;
  line-height: 1;
}

.ad-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.ad-title {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.ad-title-amber {
  color: var(--snx-amber-800);
}

.ad-title-white {
  color: #fff;
  font-size: 26rpx;
}

.ad-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.ad-desc-amber {
  color: var(--snx-amber-700);
}

.ad-desc-white {
  color: #fecaca;
}

.ad-btn {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid var(--snx-amber-200);
  color: var(--snx-amber-700);
}

.ad-btn:active {
  background: var(--snx-amber-50);
}

.ad-red-top {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.ad-red-btn {
  width: 100%;
  text-align: center;
  background: #fff;
  color: var(--snx-red);
  border-radius: 16rpx;
  padding: 16rpx 0;
  font-size: 24rpx;
  font-weight: 700;
}

.ad-red-btn:active {
  background: #fef2f2;
}

/* ===== 倒计时卡片 ===== */
.countdown-card {
  margin: 24rpx 32rpx 0;
  background: var(--snx-card);
  border: 2rpx solid var(--snx-border);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.countdown-top {
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.countdown-info {
  display: flex;
  flex-direction: column;
}

.countdown-label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--snx-red);
}

.countdown-num {
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--snx-text);
  line-height: 1.2;
}

.countdown-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--snx-text-secondary);
}

.countdown-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--snx-red-50);
  color: var(--snx-red);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.countdown-icon-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.countdown-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-top: 2rpx solid #f5f5f4;
}

.countdown-action {
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.countdown-action:active {
  background: #fafaf9;
}

.countdown-action-primary {
  color: var(--snx-red);
  border-right: 2rpx solid #f5f5f4;
}

.countdown-action-secondary {
  color: var(--snx-text-muted);
}

/* ===== 通用 section ===== */
.section {
  margin-top: 40rpx;
  padding: 0 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--snx-text);
}

.section-sub {
  font-size: 22rpx;
  color: var(--snx-text-secondary);
}

.section-week {
  font-size: 24rpx;
  color: var(--snx-red);
}

/* ===== 开始刷题 ===== */
.practice-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.practice-card {
  padding: 32rpx;
  border-radius: 24rpx;
  color: #fff;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
}

.practice-card:active {
  opacity: 0.9;
}

.practice-card-red {
  background: var(--snx-red);
}

.practice-card-gray {
  background: #4b5563;
}

.practice-icon {
  font-size: 48rpx;
  line-height: 1;
}

.practice-name {
  margin-top: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.practice-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #fee2e2;
}

.practice-card-gray .practice-desc {
  color: #e5e7eb;
}

.quick-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.quick-item {
  background: var(--snx-card);
  border: 2rpx solid var(--snx-border);
  border-radius: 16rpx;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.quick-item:active {
  background: #fafaf9;
}

.quick-icon-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0 0 0 -60rpx;
}

.quick-icon {
  font-size: 36rpx;
  color: var(--snx-red);
  line-height: 1;
}

.quick-badge {
  position: absolute;
  top: -10rpx;
  right: -16rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  background: var(--snx-red);
  color: #fff;
  font-size: 20rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-label {
  font-size: 24rpx;
  color: var(--snx-text);
  margin-top: -32rpx;
  margin-left: 60rpx;
}

/* ===== 面试技巧 ===== */
.interview-card {
  background: var(--snx-card);
  border: 2rpx solid var(--snx-border);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.interview-card:active {
  background: #fafaf9;
}

.interview-icon {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: var(--snx-red);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.interview-icon-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.interview-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.interview-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--snx-text);
}

.interview-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--snx-text-secondary);
}

.interview-arrow {
  font-size: 36rpx;
  color: #a8a29e;
  line-height: 1;
}

/* ===== 学情数据看板 ===== */
.data-card {
  background: var(--snx-card);
  border: 2rpx solid var(--snx-border);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.data-stats {
  display: flex;
  justify-content: space-between;
}

.data-item {
  display: flex;
  flex-direction: column;
}

.data-label {
  font-size: 22rpx;
  color: var(--snx-text-secondary);
}

.data-value {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.data-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--snx-text);
}

.data-unit {
  font-size: 22rpx;
  color: var(--snx-text-secondary);
}

.data-progress {
  margin-top: 28rpx;
  height: 14rpx;
  background: #f5f5f4;
  border-radius: 999rpx;
  overflow: hidden;
}

.data-progress-inner {
  height: 100%;
  background: var(--snx-red);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.data-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--snx-text-secondary);
}

.subject-list {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid #f5f5f4;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.subject-item {
  display: flex;
  flex-direction: column;
}

.subject-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.subject-name {
  font-size: 22rpx;
  color: var(--snx-text-muted);
}

.subject-percent {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--snx-red);
}

.subject-bar {
  height: 12rpx;
  background: #f5f5f4;
  border-radius: 999rpx;
  overflow: hidden;
}

.subject-bar-inner {
  height: 100%;
  background: var(--snx-red);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.home-bottom-space {
  height: 32rpx;
}
