.page-index {
  padding-bottom: 40rpx;
}

/* 顶部用户信息 */
.header {
  position: relative;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: linear-gradient(135deg, #2B6CB0 0%, #3182CE 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.header-content {
  position: relative;
  display: flex;
  align-items: center;
  padding: 60rpx 40rpx 40rpx;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  background: #fff;
}

.user-info {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.user-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.user-tag {
  display: inline-block;
  background: linear-gradient(135deg, #F6AD55 0%, #ED8936 100%);
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
  margin-top: 8rpx;
  width: fit-content;
}

.tag-text {
  font-size: 20rpx;
  color: #FFFFFF;
}

/* 轮播图 */
.banner-section {
  padding: 0 24rpx;
  margin-top: -20rpx;
}

.banner-swiper {
  height: 280rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-title {
  position: absolute;
  bottom: 20rpx;
  left: 24rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* 功能入口 */
.module-section {
  margin: 24rpx;
}

.module-grid {
  display: flex;
  flex-wrap: wrap;
}

.module-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.module-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-emoji {
  font-size: 48rpx;
}

.module-name {
  font-size: 26rpx;
  color: #2D3748;
  margin-top: 12rpx;
}

/* 通用 section */
.section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A202C;
}

.section-more {
  font-size: 24rpx;
  color: #718096;
}

/* 推荐题目 */
.recommend-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.recommend-item:last-child {
  border-bottom: none;
}

.recommend-text {
  flex: 1;
  font-size: 28rpx;
  color: #2D3748;
  margin-left: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 热门院校 */
.college-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.college-item:last-child {
  border-bottom: none;
}

.college-logo {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
}

.college-info {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.college-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2D3748;
}

.college-desc {
  font-size: 24rpx;
  color: #718096;
  margin-top: 4rpx;
}

/* 空状态占位 */
.empty-placeholder {
  padding: 40rpx 0;
  text-align: center;
}

.empty-hint {
  font-size: 26rpx;
  color: #A0AEC0;
}
