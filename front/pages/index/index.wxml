<view class="page-home">
  <!-- 顶部问候 -->
  <view class="greeting">
    <view class="greeting-left">
      <view class="greeting-row">
        <text class="greeting-title">{{greeting}}，{{nickname}}</text>
        <view class="vip-badge" wx:if="{{isVip}}">
          <text class="vip-badge-text">月度会员</text>
        </view>
      </view>
      <text class="greeting-desc">{{todayTarget}}</text>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-label">今日刷题</text>
      <view class="stat-value">
        <text class="stat-num">{{stats.today}}</text>
        <text class="stat-unit">道</text>
      </view>
    </view>
    <view class="stat-card">
      <text class="stat-label">累计刷题</text>
      <view class="stat-value">
        <text class="stat-num">{{stats.total}}</text>
        <text class="stat-unit">道</text>
      </view>
    </view>
    <view class="stat-card">
      <text class="stat-label">正确率</text>
      <view class="stat-value">
        <text class="stat-num stat-num-success">{{stats.accuracy}}</text>
        <text class="stat-unit stat-unit-success">%</text>
      </view>
    </view>
  </view>

  <!-- 主 CTA -->
  <view class="cta-card">
    <button class="btn-primary-lg" bindtap="goPractice" hover-class="btn-primary-hover">
      <text class="btn-primary-text">开始刷题</text>
    </button>
    <view class="cta-secondary">
      <view class="btn-outline-md" bindtap="goExam">
        <text class="btn-outline-text">全真模考</text>
      </view>
      <view class="btn-outline-md" bindtap="goWrongBook">
        <text class="btn-outline-text">错题本</text>
      </view>
    </view>
  </view>

  <!-- 分类入口 -->
  <view class="category-grid">
    <view class="category-item" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="goCategory">
      <view class="category-icon">
        <text class="category-icon-emoji">{{item.icon}}</text>
      </view>
      <view class="category-info">
        <text class="category-name">{{item.name}}</text>
        <text class="category-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 继续学习 -->
  <view class="continue-card">
    <view class="card-header">
      <text class="card-title">继续学习</text>
      <text class="card-more" bindtap="goHistory">全部记录 ></text>
    </view>
    <view class="continue-body" bindtap="goContinue">
      <view class="continue-icon">
        <text class="continue-icon-emoji">🔥</text>
      </view>
      <view class="continue-content">
        <view class="continue-top">
          <text class="continue-title">{{continueLearning.title}}</text>
          <text class="continue-percent">{{continueLearning.percent}}%</text>
        </view>
        <view class="progress-bar">
          <view class="progress-inner" style="width: {{continueLearning.percent}}%;"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 升学工具 -->
  <view class="tools-section">
    <text class="section-title">升学工具</text>
    <view class="tools-grid">
      <view class="tool-item" bindtap="goCollege">
        <view class="tool-icon">
          <text class="tool-icon-emoji">🏫</text>
        </view>
        <view class="tool-info">
          <text class="tool-name">院校库</text>
          <text class="tool-desc">查院校专业</text>
        </view>
      </view>
      <view class="tool-item" bindtap="goAssess">
        <view class="tool-icon">
          <text class="tool-icon-emoji">🎯</text>
        </view>
        <view class="tool-info">
          <text class="tool-name">志愿匹配测评</text>
          <text class="tool-desc">智能推荐院校</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 备考资讯 -->
  <view class="news-card">
    <view class="card-header">
      <text class="card-title">备考资讯</text>
      <text class="card-more" bindtap="goNews">更多 ></text>
    </view>
    <view class="news-list">
      <view
        class="news-item"
        wx:for="{{newsList}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="goNewsDetail"
      >
        <view class="news-tag news-tag-{{item.tagType}}">{{item.tag}}</view>
        <text class="news-title">{{item.title}}</text>
        <text class="news-arrow">></text>
      </view>
    </view>
  </view>
</view>
