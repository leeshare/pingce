.login-page {
  min-height: 100vh;
  background: #f7f6f3;
  display: flex;
  flex-direction: column;
}

/* Header：陕西单招红 #a51d26 */
.login-header {
  background: #a51d26;
  padding: 120rpx 40rpx 80rpx;
  text-align: center;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.app-desc {
  font-size: 24rpx;
  color: #FECACA;
}

/* 主区域 */
.login-main {
  flex: 1;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
}

.login-card {
  background: #FFFFFF;
  border: 2rpx solid #E7E5E4;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  color: #1E293B;
}

.card-subtitle {
  margin-top: 16rpx;
  font-size: 24rpx;
  text-align: center;
  color: #64748B;
}

/* 微信登录按钮：微信绿 #07c160 */
.btn-wechat {
  width: 100%;
  margin-top: 48rpx;
  background: #07c160;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
  padding: 28rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  overflow: hidden;
}

.btn-wechat::after {
  border: none;
}

.btn-wechat:active {
  background: #06ad56;
}

/* 按钮图标 */
.btn-icon-img {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.btn-label {
  font-size: 30rpx;
  font-weight: 600;
  white-space: nowrap;
}

/* 手机号授权区 */
.phone-section {
  margin-top: 40rpx;
  padding-top: 40rpx;
  border-top: 2rpx solid #F5F5F4;
}

.phone-section.hidden {
  display: none;
}

.phone-title {
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  color: #1E293B;
}

.phone-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  text-align: center;
  color: #64748B;
}

/* 手机号按钮：陕西单招红 #a51d26 */
.btn-phone {
  width: 100%;
  margin-top: 32rpx;
  background: #a51d26;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
  padding: 28rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  overflow: hidden;
}

.btn-phone::after {
  border: none;
}

.btn-phone:active {
  background: #8a1820;
}

/* 切换入口 */
.sms-switch {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.6;
}

.sms-link {
  color: #a51d26;
  font-weight: 600;
}

/* 验证码表单 */
.sms-form {
  margin-top: 32rpx;
}

.form-item {
  display: flex;
  align-items: center;
  background: #F5F5F4;
  border-radius: 16rpx;
  padding: 0 28rpx;
  height: 96rpx;
  margin-bottom: 20rpx;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #1E293B;
  height: 96rpx;
}

.code-item {
  padding-right: 12rpx;
}

.code-btn {
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  color: #a51d26;
  font-weight: 600;
  border-left: 2rpx solid #E7E5E4;
  flex-shrink: 0;
}

.code-btn.disabled {
  color: #94A3B8;
}

/* 协议勾选 */
.agreement {
  margin-top: 32rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: flex-start;
}

.agreement-checkbox {
  margin-top: 4rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.agreement-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.agreement-line {
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748B;
}

.agreement-link {
  color: #a51d26;
}
