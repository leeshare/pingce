.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #2B6CB0 0%, #3182CE 50%, #F7FAFC 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-header {
  padding-top: 180rpx;
  padding-bottom: 80rpx;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.app-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.features {
  display: flex;
  justify-content: space-around;
  width: 100%;
  padding: 0 40rpx;
  box-sizing: border-box;
  margin-bottom: 80rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.feature-text {
  font-size: 24rpx;
  color: #4A5568;
}

.login-actions {
  width: 100%;
  padding: 0 60rpx;
  box-sizing: border-box;
  margin-top: auto;
  padding-bottom: 100rpx;
}

.btn-login {
  background: #2B6CB0;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  height: 96rpx;
  line-height: 64rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(43, 108, 176, 0.3);
}

.btn-login::after {
  border: none;
}

.btn-login:active {
  background: #2C5282;
}

.agreement {
  text-align: center;
  margin-top: 32rpx;
}

.agreement-text {
  font-size: 24rpx;
  color: #A0AEC0;
}
